#!/usr/bin/env python3
"""Persistent WSL keepalive and telemetry stream.

Emits one compact JSON object per line. Uses only the Python standard library
and Linux procfs so it stays inexpensive and survives package upgrades.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import time
import urllib.error
import urllib.request
from typing import Dict, Optional, Tuple


SCHEMA_VERSION = 1
SECTOR_SIZE = 512


# A live DSH web server answers the loopback auth gate with 401 when the
# signed cookie is absent. 200 means a gateway already injected that cookie.
# Connection failure, 5xx, and redirects are not "the page is up".
_WEB_REACHABLE_STATUSES = frozenset({200, 401})
_DSH_WSL_URL = "http://127.0.0.1:3080/"
_DSH_WIN_CLIENT_URL = "http://127.0.0.1:19387/"
_DSH_WIN_WEB_URL = "http://127.0.0.1:19388/"


def _probe_http(url: str, timeout: float) -> Tuple[bool, str]:
    """Return (reachable, detail). Never routes the probe through proxy env."""
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(url, timeout=timeout) as response:
            status = response.status
    except urllib.error.HTTPError as exc:
        status = exc.code
    except Exception:
        return False, "未响应"
    if status in _WEB_REACHABLE_STATUSES:
        return True, "HTTP " + str(status)
    return False, "HTTP " + str(status)


def _unit_show(unit: str, user: bool = False) -> Tuple[int, Dict[str, str]]:
    command = ["show", unit, "--no-pager", "-p", "LoadState", "-p", "ActiveState", "-p", "SubState", "-p", "MainPID"]
    if user:
        code, output, _ = _systemctl_user(command, timeout=3.0)
    else:
        code, output, _ = _run(["systemctl"] + command, timeout=2.0)
    properties = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    return code, properties


def dsh_status() -> Dict[str, object]:
    code, properties = _unit_show("dsh-wsl.service")
    load = properties.get("LoadState", "unknown")
    active = properties.get("ActiveState", "unknown")
    reachable = False
    detail = ""
    error = "" if code == 0 or load == "not-found" else "systemd 状态查询失败"
    if active == "active":
        reachable, detail = _probe_http(_DSH_WSL_URL, 1.0)
        if not reachable:
            error = "本地网页暂未响应" if detail == "未响应" else "本地网页异常（" + detail + "）"
    win = dsh_win_status()
    return {
        "dshLoadState": load, "dshActiveState": active,
        "dshSubState": properties.get("SubState", "unknown"),
        "dshMainPid": int(properties.get("MainPID", "0") or "0"),
        "dshWebReady": reachable, "dshWebDetail": detail, "dshError": error,
        "dshCheckedUnixMs": int(time.time() * 1000),
        **win,
    }


def dsh_win_status() -> Dict[str, object]:
    """Windows desktop client is not a web page, and must not share dsh-wsl's ready bit.

    The client listens on 19387 and rejects a cookieless probe with 401 while its
    own window is open. 19388 is the cookie proxy that makes that same client
    reachable as a web page (dsh-win.20220414.xyz). Neither existing implies the other.
    """
    code, properties = _unit_show("dsh-win-cookie-proxy.service", user=True)
    load = properties.get("LoadState", "unknown")
    active = properties.get("ActiveState", "unknown")
    client_up, client_detail = _probe_http(_DSH_WIN_CLIENT_URL, 1.0)
    web_up = False
    web_detail = ""
    error = ""
    if not client_up and code != 0 and load not in ("loaded", "not-found"):
        error = "Windows 侧状态查询失败"
    if active == "active":
        web_up, web_detail = _probe_http(_DSH_WIN_WEB_URL, 1.0)
        if client_up and not web_up:
            error = "客户端在运行，网页入口未响应" if web_detail == "未响应" else "客户端在运行，网页入口异常（" + web_detail + "）"
    elif client_up and load == "not-found":
        error = "客户端在运行，网页入口未安装"
    return {
        "dshWinLoadState": load,
        "dshWinActiveState": active,
        "dshWinSubState": properties.get("SubState", "unknown"),
        "dshWinMainPid": int(properties.get("MainPID", "0") or "0"),
        "dshWinClientUp": client_up,
        "dshWinClientDetail": client_detail,
        "dshWinWebReady": web_up,
        "dshWinWebDetail": web_detail,
        "dshWinError": error,
        "dshWinCheckedUnixMs": int(time.time() * 1000),
    }


def _systemctl_user(command: list[str], timeout: float) -> Tuple[int, str, str]:
    """Run a systemctl --user command for the agent's owning user.

    The agent starts as root (mirroring the dsh-wsl system service probes), so
    user units such as mcp-hub.service are first queried directly; when the
    user bus is unreachable we retry via machinectl shell into the default
    user (UID 1000, the login user on single-user WSL distros).
    """
    base = ["systemctl", "--user"] + command
    env = dict(os.environ)
    env["XDG_RUNTIME_DIR"] = "/run/user/1000"
    code, output, error = _run_env(base, env, timeout)
    if code == 0 and output:
        return code, output, error
    fallback = ["machinectl", "shell", "-q", "jie@"] + base
    code2, output2, error2 = _run(fallback, timeout)
    if code2 == 0 or output2:
        return code2, output2, error2
    return code, output, error


def mcp_hub_status() -> Dict[str, object]:
    code, output, _ = _systemctl_user([
        "show", "mcp-hub.service", "--no-pager",
        "-p", "LoadState", "-p", "ActiveState", "-p", "SubState", "-p", "MainPID",
    ], timeout=3.0)
    properties = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    load = properties.get("LoadState", "unknown")
    active = properties.get("ActiveState", "unknown")
    ready = False
    error = "" if code == 0 or load == "not-found" else "systemd 用户服务查询失败"
    if active == "active":
        try:
            # MCP Streamable HTTP readiness probe: an authenticated-less JSON-RPC
            # initialize must reach the bridge. Never route via proxy env.
            request = urllib.request.Request(
                "http://127.0.0.1:43981/mcp",
                data=json.dumps({
                    "jsonrpc": "2.0", "id": 1, "method": "initialize",
                    "params": {"protocolVersion": "2025-03-26", "capabilities": {},
                               "clientInfo": {"name": "wsl-tray-agent", "version": "1"}},
                }).encode("utf-8"),
                headers={"Content-Type": "application/json",
                         "Accept": "application/json, text/event-stream"},
            )
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            with opener.open(request, timeout=2.0) as response:
                body = response.read(4096).decode("utf-8", "replace")
                ready = response.status == 200 and "serverInfo" in body
        except Exception:
            error = "MCP 网关暂未响应"
    return {
        "mcpHubLoadState": load, "mcpHubActiveState": active,
        "mcpHubSubState": properties.get("SubState", "unknown"),
        "mcpHubMainPid": int(properties.get("MainPID", "0") or "0"),
        "mcpHubReady": ready, "mcpHubError": error,
        "mcpHubCheckedUnixMs": int(time.time() * 1000),
    }


def _read_text(path: str) -> str:
    with open(path, "r", encoding="utf-8") as stream:
        return stream.read()


def _run(command: list[str], timeout: float = 3.0) -> Tuple[int, str, str]:
    return _run_env(command, None, timeout)


def _run_env(command: list[str], env: Optional[Dict[str, str]], timeout: float) -> Tuple[int, str, str]:
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
            env=env,
        )
        return completed.returncode, completed.stdout.strip(), completed.stderr.strip()
    except Exception as exc:  # telemetry must never terminate on an optional probe
        return 255, "", str(exc)


class Sampler:
    def __init__(self) -> None:
        self.previous_cpu: Optional[Tuple[int, int]] = None
        self.previous_disk: Optional[Tuple[int, int]] = None
        self.previous_network: Optional[Tuple[int, int]] = None
        self.previous_time: Optional[float] = None
        self.service_cache: Dict[str, object] = {}
        self.service_cache_time = 0.0
        self.dsh_cache: Dict[str, object] = {}
        self.dsh_cache_time = 0.0
        self.mcp_hub_cache: Dict[str, object] = {}
        self.mcp_hub_cache_time = 0.0

    @staticmethod
    def _cpu_counters() -> Tuple[int, int]:
        fields = _read_text("/proc/stat").splitlines()[0].split()[1:]
        values = [int(value) for value in fields]
        idle = values[3] + (values[4] if len(values) > 4 else 0)
        return sum(values), idle

    @staticmethod
    def _memory() -> Dict[str, int]:
        values: Dict[str, int] = {}
        for line in _read_text("/proc/meminfo").splitlines():
            key, raw = line.split(":", 1)
            token = raw.strip().split()[0]
            values[key] = int(token) * 1024
        total = values.get("MemTotal", 0)
        available = values.get("MemAvailable", values.get("MemFree", 0))
        swap_total = values.get("SwapTotal", 0)
        swap_free = values.get("SwapFree", 0)
        return {
            "memoryTotalBytes": total,
            "memoryUsedBytes": max(0, total - available),
            "swapTotalBytes": swap_total,
            "swapUsedBytes": max(0, swap_total - swap_free),
        }

    @staticmethod
    def _root_disk_counters() -> Tuple[int, int]:
        device = os.stat("/").st_dev
        target_major, target_minor = os.major(device), os.minor(device)
        for line in _read_text("/proc/diskstats").splitlines():
            fields = line.split()
            if len(fields) < 10:
                continue
            if int(fields[0]) == target_major and int(fields[1]) == target_minor:
                return int(fields[5]) * SECTOR_SIZE, int(fields[9]) * SECTOR_SIZE
        return 0, 0

    @staticmethod
    def _default_interface() -> str:
        for line in _read_text("/proc/net/route").splitlines()[1:]:
            fields = line.split()
            if len(fields) >= 4 and fields[1] == "00000000":
                return fields[0]
        return "eth0"

    @classmethod
    def _network_counters(cls) -> Tuple[str, int, int]:
        interface = cls._default_interface()
        for line in _read_text("/proc/net/dev").splitlines()[2:]:
            name, values = line.split(":", 1)
            if name.strip() != interface:
                continue
            fields = values.split()
            return interface, int(fields[0]), int(fields[8])
        return interface, 0, 0

    def _services(self, now: float) -> Dict[str, object]:
        if self.service_cache and now - self.service_cache_time < 10.0:
            return dict(self.service_cache)

        systemd_code, systemd_state, _ = _run(["systemctl", "is-system-running"])
        _, docker_state, docker_error = _run(["systemctl", "is-active", "docker.service"])
        _, ssh_state, ssh_error = _run(["systemctl", "is-active", "ssh.service"])
        _, timer_state, _ = _run(["systemctl", "is-active", "wsl-tray-watchdog.timer"])

        docker_code, docker_rows, docker_command_error = _run(
            ["docker", "ps", "-a", "--format", "{{.Names}}\t{{.State}}"], timeout=5.0
        )
        total = 0
        running = 0
        names = []
        if docker_code == 0:
            for row in docker_rows.splitlines():
                if not row.strip():
                    continue
                parts = row.split("\t", 1)
                total += 1
                names.append(parts[0])
                if len(parts) > 1 and parts[1].strip().lower() == "running":
                    running += 1

        error = docker_command_error or docker_error or ssh_error
        self.service_cache = {
            "systemdState": systemd_state or ("running" if systemd_code == 0 else "unknown"),
            "dockerActive": docker_state == "active",
            "sshActive": ssh_state == "active",
            "watchdogTimerActive": timer_state == "active",
            "containersRunning": running,
            "containersTotal": total,
            "containerNames": names,
            "serviceError": error,
        }
        self.service_cache_time = now
        return dict(self.service_cache)

    def sample(self) -> Dict[str, object]:
        now = time.monotonic()
        cpu_total, cpu_idle = self._cpu_counters()
        disk_read, disk_write = self._root_disk_counters()
        interface, network_receive, network_transmit = self._network_counters()

        cpu_percent = 0.0
        disk_read_rate = 0.0
        disk_write_rate = 0.0
        network_receive_rate = 0.0
        network_transmit_rate = 0.0
        if self.previous_time is not None:
            elapsed = max(0.001, now - self.previous_time)
            if self.previous_cpu is not None:
                total_delta = max(0, cpu_total - self.previous_cpu[0])
                idle_delta = max(0, cpu_idle - self.previous_cpu[1])
                if total_delta:
                    cpu_percent = max(0.0, min(100.0, 100.0 * (total_delta - idle_delta) / total_delta))
            if self.previous_disk is not None:
                disk_read_rate = max(0.0, (disk_read - self.previous_disk[0]) / elapsed)
                disk_write_rate = max(0.0, (disk_write - self.previous_disk[1]) / elapsed)
            if self.previous_network is not None:
                network_receive_rate = max(0.0, (network_receive - self.previous_network[0]) / elapsed)
                network_transmit_rate = max(0.0, (network_transmit - self.previous_network[1]) / elapsed)

        self.previous_cpu = (cpu_total, cpu_idle)
        self.previous_disk = (disk_read, disk_write)
        self.previous_network = (network_receive, network_transmit)
        self.previous_time = now

        memory = self._memory()
        root = shutil.disk_usage("/")
        load1, load5, load15 = os.getloadavg()
        uptime_seconds = float(_read_text("/proc/uptime").split()[0])

        result: Dict[str, object] = {
            "schemaVersion": SCHEMA_VERSION,
            "timestampUnixMs": int(time.time() * 1000),
            "hostname": os.uname().nodename,
            "kernel": os.uname().release,
            "uptimeSeconds": uptime_seconds,
            "cpuPercent": round(cpu_percent, 2),
            "processorCount": os.cpu_count() or 1,
            "load1": round(load1, 3),
            "load5": round(load5, 3),
            "load15": round(load15, 3),
            "diskReadBytesPerSecond": int(disk_read_rate),
            "diskWriteBytesPerSecond": int(disk_write_rate),
            "networkInterface": interface,
            "networkReceiveBytesPerSecond": int(network_receive_rate),
            "networkTransmitBytesPerSecond": int(network_transmit_rate),
            "rootTotalBytes": root.total,
            "rootUsedBytes": root.used,
        }
        result.update(memory)
        result.update(self._services(now))
        if not self.dsh_cache or now - self.dsh_cache_time >= 5.0:
            self.dsh_cache = dsh_status()
            self.dsh_cache_time = now
        result.update(self.dsh_cache)
        if not self.mcp_hub_cache or now - self.mcp_hub_cache_time >= 5.0:
            self.mcp_hub_cache = mcp_hub_status()
            self.mcp_hub_cache_time = now
        result.update(self.mcp_hub_cache)
        return result


def main() -> int:
    parser = argparse.ArgumentParser(description="WSL tray keepalive telemetry agent")
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--dsh-status", action="store_true")
    parser.add_argument("--dsh-win-status", action="store_true")
    parser.add_argument("--mcp-hub-status", action="store_true")
    args = parser.parse_args()
    if args.dsh_win_status:
        result = dsh_win_status()
        result["schemaVersion"] = SCHEMA_VERSION
        print(json.dumps(result, ensure_ascii=False), flush=True)
        return 0
    if args.dsh_status:
        result = dsh_status()
        result["schemaVersion"] = SCHEMA_VERSION
        print(json.dumps(result, ensure_ascii=False), flush=True)
        return 0
    if args.mcp_hub_status:
        result = mcp_hub_status()
        result["schemaVersion"] = SCHEMA_VERSION
        print(json.dumps(result, ensure_ascii=False), flush=True)
        return 0
    interval = max(0.5, min(60.0, args.interval))

    stopping = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    sampler = Sampler()
    if args.once:
        sampler.sample()
        time.sleep(min(0.25, interval))
        print(json.dumps(sampler.sample(), ensure_ascii=False, separators=(",", ":")), flush=True)
        return 0

    while not stopping:
        started = time.monotonic()
        try:
            payload = sampler.sample()
            print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), flush=True)
        except Exception as exc:
            print(
                json.dumps(
                    {
                        "schemaVersion": SCHEMA_VERSION,
                        "timestampUnixMs": int(time.time() * 1000),
                        "agentError": str(exc),
                    },
                    ensure_ascii=False,
                    separators=(",", ":"),
                ),
                flush=True,
            )
        remaining = interval - (time.monotonic() - started)
        if remaining > 0:
            time.sleep(remaining)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
